        $wa->registerAndUseStyle('footer-css',   $templatePath . '/footer.min.css');

        // Custom CSS z parametrów szablonu
        $customCss = $this->params->get('custom_css');
        if (!empty($customCss)) {
            $wa->addInlineStyle($customCss);
        }
        ?>
        <!-- Preload Font Awesome webfonts – redukcja CLS -->
        <link rel="preload" href="<?php echo $this->baseurl; ?>/media/vendor/fontawesome-free/webfonts/fa-brands-400.woff2" as="font" type="font/woff2" crossorigin>
