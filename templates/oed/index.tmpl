<?php
/**
 * Szablon oed – Joomla 6 + Tailwind CSS
 *
 * Mapa pozycji modułów:
 *   top1            → top1           (pasek nad nagłówkiem, 100%)
 *   hleft           → header-left    (lewa część nagłówka, 6/12)
 *   hdr             → header-center  (środek nagłówka, 3/12)
 *   hright          → header-right   (prawa część nagłówka, 3/12)
 *   Menu            → menu           (główna nawigacja)
 *   stopka          → prefooter      (pasek nad stopką, 100%)
 *   LeftFooterArea  → footer-left    (lewa kolumna stopki)
 *   CenterFooterArea→ footer-middle  (środkowa kolumna stopki)
 *   RightFooterArea → footer-right   (prawa kolumna stopki)
 */

defined('_JEXEC') or die;

use Joomla\CMS\Factory;
use Joomla\CMS\Uri\Uri;

$app          = Factory::getApplication();
$template     = $app->getTemplate(true);
$subtemplate  = $template->params->get('subtemplate', 'default');

$wa           = $app->getDocument()->getWebAssetManager();
$templatePath = 'templates/' . $this->template;
$wa->useStyle('fontawesome');
?>
